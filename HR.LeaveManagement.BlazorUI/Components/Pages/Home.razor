@page "/"
@attribute [Authorize]
@inherits ApiPageBase
<PageTitle>Vue d'ensemble · Congé</PageTitle>
<PageHeader Eyebrow="VOTRE TABLEAU DE BORD" Title="@($"Bonjour, {Api.User?.UserName}.")" Description="Votre équipe et vos congés, en un coup d'œil.">
    <a class="button primary" href="/demandes"><AppIcon Name="plus" />Nouvelle demande</a>
</PageHeader>
<Feedback Error="@Error" Success="@Success" Busy="@IsBusy" />
<section class="welcome-banner"><div><span class="section-label">L'ÉQUILIBRE, ÇA S'ORGANISE</span><h2>Moins d'administratif.<br />Plus de tranquillité.</h2><p>Retrouvez vos demandes et les jours disponibles dans un seul espace.</p><a href="/allocations" class="text-link">Consulter les allocations <AppIcon Name="arrow" /></a></div><div class="banner-graphic" aria-hidden="true"><div class="graphic-ring"></div><span class="graphic-calendar"><AppIcon Name="calendar" /></span><span class="graphic-check">✓</span><span class="graphic-pill">Tout commence par un peu de temps.</span></div></section>
<div class="stats-grid">
    <div class="stat-card"><span class="stat-icon teal"><AppIcon Name="layers" /></span><span class="stat-label">Jours disponibles · @DateTime.Today.Year</span><strong>@allocations.Where(x => x.Period == DateTime.Today.Year).Sum(x => x.NumberOfDays)</strong><small>@(Api.User?.IsAdministrator == true ? "Total des soldes de l'équipe" : "Votre solde tous types confondus")</small></div>
    <div class="stat-card"><span class="stat-icon amber"><AppIcon Name="clock" /></span><span class="stat-label">Demandes en attente</span><strong>@requests.Count(x => !x.Cancelled && !x.Approved.HasValue)</strong><small>@(Api.User?.IsAdministrator == true ? "À examiner par l'administration" : "En cours d'examen")</small></div>
    <div class="stat-card"><span class="stat-icon blue"><AppIcon Name="check" /></span><span class="stat-label">Demandes approuvées</span><strong>@requests.Count(x => !x.Cancelled && x.Approved == true)</strong><small>Demandes actives, toutes années</small></div>
    <div class="stat-card"><span class="stat-icon violet"><AppIcon Name="calendar" /></span><span class="stat-label">Types de congé</span><strong>@types.Count</strong><small>Des catégories adaptées à votre équipe</small></div>
</div>
<div class="dashboard-grid">
    <section class="panel"><div class="panel-heading"><div><h2>Les dernières demandes</h2><p>Suivez les décisions et les prochaines absences.</p></div><a class="text-link" href="/demandes">Tout voir <AppIcon Name="arrow" /></a></div>
        @if (!IsBusy && requests.Count == 0) { <EmptyState Icon="calendar" Title="Tout est calme pour le moment" Description="Vos demandes apparaîtront ici après leur création." /> }
        else { <div class="table-wrap"><table><thead><tr><th>Type de congé</th><th>Période</th><th>Statut</th></tr></thead><tbody>@foreach (var item in requests.OrderByDescending(x => x.Id).Take(5)) { <tr><td><strong>@item.LeaveType.Name</strong></td><td>@item.StartDate.ToString("dd MMM") – @item.EndDate.ToString("dd MMM yyyy")</td><td><span class="badge @item.StatusClass">@item.Status</span></td></tr> }</tbody></table></div> }
    </section>
    <section class="panel quick-links"><span class="section-label">POUR ALLER À L'ESSENTIEL</span><h2>Vos raccourcis</h2><a href="/demandes"><span class="quick-icon"><AppIcon Name="requests" /></span><span><strong>Demandes de congé</strong><small>Créer, suivre et organiser</small></span><AppIcon Name="arrow" /></a><a href="/allocations"><span class="quick-icon"><AppIcon Name="layers" /></span><span><strong>Allocations</strong><small>Consulter les soldes disponibles</small></span><AppIcon Name="arrow" /></a>@if (Api.User?.IsAdministrator == true) { <a href="/utilisateurs"><span class="quick-icon"><AppIcon Name="users" /></span><span><strong>Votre équipe</strong><small>Gérer les comptes et les rôles</small></span><AppIcon Name="arrow" /></a> }<div class="tip"><strong>Un repère utile</strong><p>Les jours sont déduits à l'approbation et restitués à l'annulation.</p></div></section>
</div>
@code {
    private List<AllocationModel> allocations = [];
    private List<LeaveRequestModel> requests = [];
    private List<LeaveTypeModel> types = [];
    protected override async Task LoadAsync()
    {
        allocations = await Api.GetAllocationsAsync();
        requests = await Api.GetRequestsAsync();
        types = await Api.GetTypesAsync();
    }
}