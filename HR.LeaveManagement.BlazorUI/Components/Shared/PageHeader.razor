<header class="page-heading">
    <div><p class="eyebrow">@Eyebrow</p><h1>@Title</h1><p class="page-description">@Description</p></div>
    @if (ChildContent is not null) { <div class="heading-actions">@ChildContent</div> }
</header>
@code {
    [Parameter] public string Eyebrow { get; set; } = "ESPACE RH";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}