{
  "JwtSettings": {
    "Issuer": "HR.LeaveManagement.Api",
    "Audience": "HR.LeaveManagement.Client",
    "DurationInMinutes": 60
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "LogFiles": {
    "Path": "Logs/hr-leave-.json"
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7040",
      "http://localhost:5195"
    ]
  },
  "StatsWorker": {
    "Enabled": true,
    "Interval": "00:03:00"
  },
  "EmailSettings": {
    "Enabled": false,
    "Provider": "Smtp",
    "FromAddress": "noreply@hr.local",
    "FromName": "HR Leave Management",
    "Host": "localhost",
    "Port": 587,
    "EnableSsl": true
  }
}
